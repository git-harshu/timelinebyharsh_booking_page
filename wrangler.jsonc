{
  // Timeline by Harsh: static site (dist/) + payment and form endpoints, one Worker.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "harsh-timeline",
  "main": "worker/index.js",
  // Pinned so a deploy can only land in Akashy8889@gmail.com's Cloudflare account.
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // api/_mail.js imports nodemailer; inside the Worker that import is swapped for an SMTP-over-sockets shim.
  "alias": { "nodemailer": "./worker/nodemailer-shim.js" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
  // Secrets (wrangler secret put): GMAIL_USER, GMAIL_APP_PASSWORD, OWNER_EMAIL
}
